{
  "name": "@misofm/control-surface",
  "version": "0.1.2",
  "description": "Typed control-surface drivers and Web MIDI transport for browser-based audio applications.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/misofm/control-surface.git"
  },
  "homepage": "https://github.com/misofm/control-surface#readme",
  "bugs": {
    "url": "https://github.com/misofm/control-surface/issues"
  },
  "keywords": [
    "control-surface",
    "midi",
    "web-midi",
    "mackie-control",
    "x-touch",
    "daw",
    "audio"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.3.14",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "bun run build",
    "prepublishOnly": "bun run typecheck && bun run test"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./xtouch": {
      "types": "./dist/xtouch/index.d.ts",
      "default": "./dist/xtouch/index.js"
    },
    "./xtouch/mcu": {
      "types": "./dist/xtouch/mcu.d.ts",
      "default": "./dist/xtouch/mcu.js"
    },
    "./xtouch/web-midi": {
      "types": "./dist/xtouch/web-midi.d.ts",
      "default": "./dist/xtouch/web-midi.js"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "typescript": "~6",
    "vitest": "^4.1.10"
  }
}
